{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hieunguyenak92/rea-video-pro-max/schemas/analysis.json",
  "title": "REA Video analysis v1",
  "description": "Structural contract. Runtime additionally checks clocks, glyphs, media identity, path confinement and resource budgets. Unknown fields are preserved for forward-compatible evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "source",
    "coverage",
    "shots",
    "captions",
    "style",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "rea-video-analysis"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "width",
        "height",
        "duration"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start",
          "end",
          "text",
          "bbox"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "style": {
      "type": "object"
    },
    "unknowns": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
