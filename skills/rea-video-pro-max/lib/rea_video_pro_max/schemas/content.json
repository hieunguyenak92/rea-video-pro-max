{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hieunguyenak92/rea-video-pro-max/schemas/content.json",
  "title": "REA Video content v1",
  "description": "Structural contract. Runtime additionally checks clocks, glyphs, media identity, path confinement and resource budgets. Unknown fields are preserved for forward-compatible evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "rea-video-content"
    },
    "width": {
      "type": "integer",
      "minimum": 64,
      "maximum": 3840
    },
    "height": {
      "type": "integer",
      "minimum": 64,
      "maximum": 3840
    },
    "fps": {
      "type": "number",
      "minimum": 1,
      "maximum": 60
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000
          },
          "asset": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 120
          }
        }
      }
    }
  },
  "additionalProperties": true
}
